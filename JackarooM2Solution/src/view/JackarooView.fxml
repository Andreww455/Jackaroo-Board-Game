<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="900.0" prefWidth="1300.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.JackarooController">
   <center>
      <GridPane fx:id="boardGrid" alignment="CENTER" hgap="1.0" prefHeight="700.0" prefWidth="700.0" styleClass="board-grid" vgap="1.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </GridPane>
   </center>
   <top>
      <HBox fx:id="playerInfoPanel" alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0" styleClass="player-info-panel" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </top>
   <bottom>
      <VBox fx:id="messagePanel" prefHeight="150.0" prefWidth="100.0" styleClass="message-panel" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="message-title" text="Game Messages:">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <TextArea fx:id="gameMessageArea" editable="false" prefHeight="100.0" styleClass="game-message-area" wrapText="true" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </bottom>
   <right>
      <VBox fx:id="gameControlPanel" alignment="CENTER" prefHeight="200.0" prefWidth="300.0" spacing="10.0" styleClass="game-control-panel" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="currentActionLabel" styleClass="action-label" text="Waiting for game to start...">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Label styleClass="section-title" text="Your Hand">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <HBox fx:id="cardHandContainer" alignment="CENTER" spacing="10.0" styleClass="card-hand-container" />
               </children>
            </VBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <VBox alignment="CENTER" spacing="5.0" styleClass="deck-container">
                     <children>
                        <Label styleClass="deck-label" text="Deck">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <StackPane>
                           <children>
                              <Rectangle arcHeight="10.0" arcWidth="10.0" height="90.0" styleClass="deck" width="60.0" />
                              <Label fx:id="deckSizeLabel" styleClass="deck-size" text="0" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </StackPane>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="5.0" styleClass="fire-pit-container">
                     <children>
                        <Label styleClass="fire-pit-label" text="Fire Pit">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <StackPane>
                           <children>
                              <Rectangle arcHeight="10.0" arcWidth="10.0" height="90.0" styleClass="fire-pit" width="60.0" />
                              <Label fx:id="firePitSizeLabel" styleClass="fire-pit-size" text="0" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </StackPane>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0" styleClass="action-buttons">
               <children>
                  <ComboBox fx:id="marbleSelector" prefWidth="150.0" promptText="Select Marble" styleClass="marble-selector" />
                  <Button fx:id="playCardButton" mnemonicParsing="false" styleClass="play-button" text="Play Card" />
                  <Button fx:id="skipTurnButton" mnemonicParsing="false" styleClass="skip-button" text="Skip Turn" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10.0" styleClass="split-distance-container">
               <children>
                  <Label styleClass="split-label" text="Split Distance:" />
                  <TextField fx:id="splitDistanceField" prefWidth="80.0" styleClass="split-field" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </right>
</BorderPane>
